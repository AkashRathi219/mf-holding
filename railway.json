{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "python -m pip install --no-cache-dir -r deploy/requirements-slim.txt"
  },
  "deploy": {
    "startCommand": "python deploy/bootstrap.py && PYTHONUNBUFFERED=1 python -m uvicorn webapp.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
